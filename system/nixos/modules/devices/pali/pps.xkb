default
partial alphanumeric_keys
xkb_symbols "pps" {

    include "us(basic)"

    name[Group1]= "English, with Pali, Prakrit and Sanskrit";

    key <AD03> {        [         e,    E,      U0113, U0112]   };

// ṭ Ṭ
    key <AD05> {        [         t,    T,      U1E6D, U1E6C]   };

// ū Ū
    key <AD07> {        [         u,    U,      U016B, U016A]   };

// ī Ī
    key <AD08> {        [         i,    I,      U012B, U012A]   };

// ā Ā
    key <AC01> {        [         a,    A,      U0101, U0100]   };

// ṣ Ṣ
    key <AC02> {        [         s,    S,      U1E63, U1E62]   };

// ḍ Ḍ
    key <AC03> {        [         d,    D,      U1E0D, U1E0C]   };

// ñ Ñ (Palatal)
    key <AC05> {        [         g,    G,      UF1, UD1]   };

// ṅ Ṅ (Gutteral)
    key <AC06> {        [         h,    H,      U1E45, U1E44]   };

// ṁ Ṁ ("Niggahīta", as used in Bhikkhu Manuals, etc.)
    key <AC07> {        [         j,    J,      U1E41, U1E40]   };

// ŋ Ŋ ("Niggahīta", as used in some chanting books, etc.)
    key <AC08> {        [         k,    K,      U14B, U14A]  };

// ḷ Ḷ
    key <AC09> {        [         l,    L,      U1E37, U1E36]   };

// ś Ś
    key <AB01> {        [         z,    Z,      U015B, U015A]   };

// ñ Ñ (Palatal)
    key <AB04> {        [         v,    V,      UF1, UD1]   };

// ṅ Ṅ (Gutteral)
    key <AB05> {        [         b,    B,      U1E45, U1E44]   };

// ṇ Ṇ (Retroflex/Cerebral)
    key <AB06> {        [         n,    N,      U1E47, U1E46]   };

// ṃ Ṃ ("Niggahīta", as used in Wisdom Publications, etc.)
    key <AB07> {        [         m,    M,      U1E43, U1E42]   };

// ṁ Ṁ ("Niggahīta", as used in Bhikkhu Manuals, etc.)
    key <AB08> {        [         comma,    less,      U1E41, U1E40]   };

// ŋ Ŋ ("Niggahīta", as used in some chanting books, etc.)
    key <AB09> {        [         period,    greater,      U14B, U14A]   };

    include "level3(ralt_switch)"
};
