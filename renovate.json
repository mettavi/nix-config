{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboard": true,
  "extends": ["config:recommended"],
  "timezone": "Asia/Colombo",
  "schedule": ["before 6am on monday"],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "pinDigests": true,
      "separateMinorPatch": true,
      "semanticCommits": "enabled",
      "commitMessagePrefix": "feat(containers):"
    },
    {
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["digest", "patch", "minor"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update container images in quadlet-nix definitions",
      "fileMatch": ["^hosts/.*\\.nix$", "^services/.*\\.nix$"],
      "matchStrings": [
        "image\\s*=\\s*\"(?<depName>[a-zA-Z0-9./_:-]+):(?<currentValue>[a-zA-Z0-9._-]+)(@(?<currentDigest>sha256:[a-f0-9]+))?\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ]
}
