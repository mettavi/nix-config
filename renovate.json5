{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  dependencyDashboard: true,
  extends: ["config:recommended"],
  timezone: "Asia/Colombo",
  schedule: ["before 6am on monday"],
  packageRules: [
    {
      matchDatasources: ["docker"],
      pinDigests: true,
      separateMinorPatch: true,
      semanticCommits: "enabled",
      commitMessagePrefix: "feat(containers):",
    },
    {
      matchDatasources: ["docker"],
      matchUpdateTypes: ["digest", "patch", "minor"],
      automerge: true,
      // change to "branch" to skip PRs and CI
      automergeType: "pr",
      platformAutomerge: true,
    },
    {
      // must come AFTER the general automerge rule, because later rules win
      matchPackageNames: ["docker.io/fosrl/pangolin", "fosrl/pangolin"],
      matchUpdateTypes: ["minor", "major"],
      automerge: false,
    },
    {
      // pre-1.0 images: minor bumps can be breaking, so review them by hand
      matchDatasources: ["docker"],
      matchCurrentValue: "/^v?0\\./",
      matchUpdateTypes: ["minor", "major"],
      automerge: false,
    },
    {
      // tags look like "ee-1.21.1"; patch is optional in case some are "ee-1.25"
      matchDatasources: ["docker"],
      matchPackageNames: ["docker.io/fosrl/pangolin", "fosrl/pangolin"],
      versioning: "regex:^ee-(?<major>\\d+)\\.(?<minor>\\d+)(\\.(?<patch>\\d+))?$",
    },
    {
      // locally built images: there is no registry to check
      matchPackageNames: ["localhost/**"],
      enabled: false,
    },
    {
      matchDatasources: ["docker"],
      matchPackageNames: ["/linuxserver\\//"],
      // excludes any version strings between 10 and 20 (legacy Ubuntu releases)
      allowedVersions: "!/^(1[0-9]|20)\\./",
    },
  ],
  customManagers: [
    {
      customType: "regex",
      description: "Update container images in quadlet-nix definitions",
      // matches *.nix files in {system,home}/{nixos,shared}/modules
      managerFilePatterns: [
        "/^(system|home)/(nixos|shared)/modules/.*\\.nix$/",
      ],
      matchStrings: [
        'image\\s*=\\s*"(?<depName>[a-zA-Z0-9./_:-]+):(?<currentValue>[a-zA-Z0-9._-]+)(@(?<currentDigest>sha256:[a-f0-9]+))?"',
      ],
      datasourceTemplate: "docker",
      versioningTemplate: "docker",
    },
  ],
}
